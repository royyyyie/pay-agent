# 环境：local / test / staging / production
DAMAI_AGENT_ENVIRONMENT=local

# Python Agent 内部 API 密钥。local/test 可留空；staging/production 至少 32 字符。
DAMAI_AGENT_INTERNAL_API_KEY=

# demo：无需模型密钥；openai_compatible：调用支持 Chat Completions 的模型服务
DAMAI_AGENT_PROVIDER=demo
DAMAI_AGENT_HOST=127.0.0.1
DAMAI_AGENT_PORT=9010

# Java 节目服务及 Tool Gateway 密钥
DAMAI_JAVA_BASE_URL=http://127.0.0.1:6086
DAMAI_JAVA_TOOL_API_KEY=change-me-local
DAMAI_JAVA_TIMEOUT_SECONDS=5

# 使用 openai_compatible 时填写
DAMAI_LLM_BASE_URL=https://api.openai.com/v1
DAMAI_LLM_API_KEY=
DAMAI_LLM_MODEL=
DAMAI_LLM_TIMEOUT_SECONDS=30

# 阶段 3：默认不重试。仅暂时性网络错误或 HTTP 408/429/5xx 可重试；
# 流式输出一旦发出任何事件，不重试、不切换备用模型。
DAMAI_LLM_MAX_RETRIES=0
DAMAI_LLM_RETRY_BACKOFF_SECONDS=0.2
# 备用模型必须三个字段同时配置；默认关闭。密钥只通过安全配置注入。
DAMAI_LLM_FALLBACK_BASE_URL=
DAMAI_LLM_FALLBACK_API_KEY=
DAMAI_LLM_FALLBACK_MODEL=

# 阶段 3 使用量治理：0 表示关闭。费用单位为 1/1,000,000 美元。
# 定价表 key 必须与模型实际返回的 modelRoute 完全一致；每条记录含 version、
# prompt_micro_usd_per_million、completion_micro_usd_per_million。
# 示例：{"openai-compatible/model-a":{"version":"2026-09","prompt_micro_usd_per_million":1000000,"completion_micro_usd_per_million":2000000}}
# DAMAI_LLM_PRICING_JSON=
DAMAI_AGENT_MAX_TURN_TOKENS=0
DAMAI_AGENT_MAX_TURN_COST_MICRO_USD=0
# durable 模式可启用 Redis 中按 UTC 日记账的共享租户额度；0 表示关闭。
DAMAI_AGENT_TENANT_DAILY_COST_MICRO_USD=0

# 可选 OTLP/HTTP Trace，须安装 observability extra；完整 URL 以 /v1/traces 结尾。
# staging/production 要求 HTTPS。Span 不写 Prompt、用户、Tool 参数或结果。
DAMAI_AGENT_OTLP_TRACES_ENDPOINT=

# Provider/SSE 连续无事件超过此时间后安全终止
DAMAI_AGENT_STREAM_IDLE_TIMEOUT_SECONDS=15

DAMAI_AGENT_MAX_TOOL_ROUNDS=6
DAMAI_AGENT_MAX_CONCURRENT_READ_TOOLS=4
DAMAI_AGENT_TOOL_TIMEOUT_SECONDS=8

# 模型请求输入的字符预算（含消息与 Tool Schema）；单个 Tool Result 的字符上限
DAMAI_AGENT_MAX_CONTEXT_CHARS=80000
DAMAI_AGENT_MAX_TOOL_RESULT_CHARS=16000

# 阶段 2 持久化入口：先由迁移账号按 001、002、003 顺序执行 migrations。
# 开启后提供签名委托的 /api/v2/turns 与断线事件读取；v1 兼容入口不自动切换。
DAMAI_AGENT_RUNTIME_BACKEND=memory
DAMAI_AGENT_POSTGRES_DSN=
DAMAI_AGENT_REDIS_URL=
DAMAI_AGENT_DELEGATION_HMAC_KEY=
DAMAI_AGENT_EVENT_POLL_SECONDS=0.5
# 启用时需先执行 migrations/004_agent_tool_audit.sql；审计落库失败会中断 Turn。
DAMAI_AGENT_PERSIST_TOOL_AUDIT=false

# 阶段 4：仅加载经过审核的稳定规则知识。动态库存、价格和订单事实不会进入 RAG。
DAMAI_AGENT_RAG_ENABLED=false
DAMAI_AGENT_RAG_BACKEND=local
DAMAI_AGENT_KNOWLEDGE_CATALOG_PATH=
# 逗号分隔，只允许目录文档声明这些 HTTPS 来源主机。
DAMAI_AGENT_KNOWLEDGE_SOURCE_HOSTS=
DAMAI_AGENT_RAG_TOP_K=4
DAMAI_AGENT_RAG_MAX_CONTEXT_CHARS=8000
DAMAI_AGENT_RAG_MIN_SCORE=0.01

# 云 Elasticsearch 只读检索；backend=elasticsearch 时必填。索引名必须是受控别名。
DAMAI_AGENT_ELASTICSEARCH_URL=
DAMAI_AGENT_ELASTICSEARCH_API_KEY=
DAMAI_AGENT_ELASTICSEARCH_INDEX_ALIAS=
DAMAI_AGENT_KNOWLEDGE_INDEX_VERSION=
DAMAI_AGENT_ELASTICSEARCH_TIMEOUT_SECONDS=3
